# Copy to .env beside compose.yml and fill in. Nothing here has a safe default
# except the prefix: the two tokens are secrets and the domain is yours.

# The site. The tunnel decides what answers on it; these two are what the page
# itself uses — DOMAIN for the www redirect, PUBLIC_URL for share links.
DOMAIN=omettomaps.com
PUBLIC_URL=https://omettomaps.com

# The way in: Zero Trust -> Networks -> Tunnels -> create a tunnel -> copy the
# token here. The tunnel dials out, so this machine needs no open port.
CF_TUNNEL_TOKEN=

# The Queen Cloud tenant: the broker URL and the bearer token it issued. The
# token reaches the container as an environment variable and is never a
# command-line flag, so it does not show up in `ps` or in the image.
# Until they are real, http://127.0.0.1:1 keeps the service in degraded mode:
# it routes, and favourites and history answer 503.
QUEEN_URL=https://<your-tenant>.queen.cloud
QUEEN_TOKEN=

# Every queue and the KV namespace start with this, so nothing in the tenant
# can collide with anything else in it: queues ometto.routes and
# ometto.replies, KV namespace ometto.
QUEEN_PREFIX=ometto.

# The image to run. Built on the Mac for amd64 and either pushed to a registry
# or carried over as a tar (see README.md).
OMETTO_IMAGE=ometto:3

# Only the `caddy` profile uses this; the tunnel needs no certificate of ours.
ACME_EMAIL=

# info, or debug to log every tile as well (noisy).
LOG_LEVEL=info

# Optional. The terrain tiles the page drapes over the map; the default is the
# public AWS Terrarium set. The disclaimer version changes when the wording a
# person accepted changes.
TERRAIN_URL=
DISCLAIMER_VERSION=1
